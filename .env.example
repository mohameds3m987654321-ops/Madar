APP_NAME="منصة مدار"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Set to the CDN origin for versioned public assets in production.
ASSET_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Set these locally before running the database seeder. Use a unique password.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=returnprojects
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production defaults to secure cookies; override only when your environment requires it.
# SESSION_SECURE_COOKIE=true
# Production defaults to requiring 2FA for administrators and teachers.
# REQUIRE_2FA=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_TIMEOUT=10
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Optional destination for queued notifications about chatbot escalations.
SUPPORT_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Optional CDN URL for files stored on the public disk.
PUBLIC_STORAGE_URL=

# Production backups default to the configured S3 disk. Set a strong,
# unique archive password and an address that can receive backup alerts.
BACKUP_NOTIFICATION_EMAIL=
BACKUP_ARCHIVE_PASSWORD=
# Optional comma-separated disk list (for example: s3).
# BACKUP_DISKS=
# Optional Slack webhook for backup alerts.
BACKUP_SLACK_WEBHOOK_URL=

VITE_APP_NAME="${APP_NAME}"

PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_VODAFONE_CASH_INTEGRATION_ID=
PAYMOB_FAWRY_INTEGRATION_ID=
